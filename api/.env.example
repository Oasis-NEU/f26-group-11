APP_ENV=dev
REPOSITORY_BACKEND=postgres
CORS_ORIGINS=["http://localhost:3000"]
# Server-only Supabase Postgres connection. For local development, the repository
# root .env.db is also loaded; api/.env and environment variables override it.
# Alternatively use REPOSITORY_BACKEND=supabase with URL/key below (no DB password).
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5433/khouryconnect
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-legacy-anon-key
# Explicit local-only impersonation; ignored when APP_ENV=prod.
DEV_AUTH_ENABLED=false
