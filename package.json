{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose --env-file .env.db up -d --wait",
    "db:native:up": "node scripts/db-native.mjs up",
    "db:native:down": "node scripts/db-native.mjs down",
    "db:native:status": "node scripts/db-native.mjs status",
    "db:down": "docker compose --env-file .env.db down",
    "db:migrate": "node --env-file-if-exists=.env.db scripts/db.mjs migrate",
    "db:status": "node --env-file-if-exists=.env.db scripts/db.mjs status",
    "db:test": "node --env-file-if-exists=.env.db --test tests/database.test.mjs"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
